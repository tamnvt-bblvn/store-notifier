# Sao chép file này thành .env và điền giá trị thật (không commit .env).

DISCORD_TOKEN=your_bot_token_here

# ID kênh nguồn (tin tổng / Google Play webhook / v.v.)
SOURCE_CHANNEL_ID=123456789012345678

# JSON: từ khóa (trong nội dung hoặc embed) -> ID kênh đích (chuỗi số)
# Ví dụ một dòng trong .env (PowerShell: dùng dấu nháy ngoài cho toàn bộ JSON):
# CHANNEL_MAP_JSON={"App_A":"111222333444555666","App_B":"999888777666555444","com.company.game1":"777666555444333222"}

CHANNEL_MAP_JSON={"App_A":"111222333444555666","App_B":"999888777666555444"}
